# API, background worker and availability probe share this image.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TF_CPP_MIN_LOG_LEVEL=2

WORKDIR /app
RUN useradd --create-home --uid 1000 app

COPY requirements/serving.txt requirements/serving.txt
RUN pip install -r requirements/serving.txt

COPY config config
COPY utils utils
COPY src src
COPY api api
COPY worker worker
# A new named volume copies this directory's ownership, so the non-root user can write state.
RUN mkdir -p /app/state && chown app:app /app/state

USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=4)"
CMD ["uvicorn", "api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
