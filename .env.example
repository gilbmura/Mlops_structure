# Copy to .env and fill in. Never commit .env.

# Required for uploads, retraining, promotion and rollback (sent as the X-Admin-Key header).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Local (non-Docker) runs: where the UI and the probe find the API.
# Use 127.0.0.1, not localhost: on Windows "localhost" adds ~2 s per new connection (IPv6 tried first).
API_URL=http://127.0.0.1:8000

# Optional path to the BRISC 2025 ZIP for scripts/prepare_dataset.py.
BRISC_ARCHIVE=

# Optional overrides (defaults shown). Relative paths resolve against the repository root.
# APP_DATA_DIR=data
# APP_STATE_DIR=data/runtime
# MODELS_DIR=models
# REPORTS_DIR=reports
# LOG_LEVEL=INFO
# TF_NUM_THREADS=0            # 0 = TensorFlow default; set 1 per API replica when several share a machine

# Docker resource knobs (docker-compose.yml)
# API_CPUS=1.0
# API_TF_THREADS=1
# WORKER_CPUS=4.0
# WORKER_TF_THREADS=0
# PROBE_INTERVAL_SECONDS=30
