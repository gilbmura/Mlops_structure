# Environments, secrets and local tool settings
.venv/
.env
.claude/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Data: the train and test images (~121 MB, BRISC 2025, CC BY 4.0) and the manifests are
# included. Validation / retrain-demo images, caches and runtime state are regenerated
# with scripts/prepare_dataset.py.
data/*
!data/README.md
!data/manifests/
!data/train/
!data/test/

# Model registry: delivered versions v001-v004 and the top-level copy of the served model
# are included (see models/README.md); later candidates stay local.
models/*
!models/README.md
!models/registry.json
!models/brain_mri_classifier.h5
!models/versions/
models/versions/*
!models/versions/v001/
!models/versions/v002/
!models/versions/v003/
!models/versions/v004/

# Locally generated deployment bundle; rebuild it after code changes.
deploy-package*.tar.gz

# Load-test scratch output (curated raw results live in loadtest/results/)
loadtest/tmp/
